; Engine configuration file.
; It's best edited using Godot 4.x.

config_version=5

[application]
config/name="Frontier Gallop"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2")

[rendering]
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.89, 0.73, 0.51, 1)

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":87)]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":83)]
}
turn_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":65)]
}
turn_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":68)]
}
accelerate={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":4194320)]
}
brake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":81)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":69)]
}
